---
import DevIcon from './DevIcon.astro';

interface props {
  name: string;
  years: string;
}

const { name, years } = Astro.props;
---

<div class="flex items-center gap-3 rounded-md bg-card p-3 shadow-paper ring-1 ring-line">
  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-fallback">
    <DevIcon name={name} className={' '} />
  </span>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-heading">{name}</p>
    <p class="font-mono text-xs text-ink-subtle">{years}</p>
  </div>
</div>
