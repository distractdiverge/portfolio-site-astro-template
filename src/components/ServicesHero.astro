---
import { Image } from 'astro:assets';
import HeroImage from "../assets/ShadowForest.webp";

const services = [
  {
    title: "Software Engineering Consulting",
    description: "Helping teams with architecture, agile practices, and code reviews."
  },
  {
    title: "Software Test Automation",
    description: "Building robust, maintainable automated test suites for continuous integration."
  },
  {
    title: "Engineering Mentoring",
    description: "Guiding up-and-coming engineers and testers in best practices."
  },
];
---

<section id="services" aria-labelledby="services-heading" class="mt-12">
  <h2 id="services-heading" class="text-2xl font-semibold text-heading">What I do</h2>
  <p class="mt-2 text-ink-soft">Remote consulting, test automation, and mentoring.</p>

  <ul class="mt-6 grid gap-6 sm:grid-cols-3">
    {services.map((service) => (
      <li class="flex flex-col gap-2 rounded-lg bg-card p-5 shadow-paper ring-1 ring-line">
        <h3 class="text-lg font-semibold text-heading">{service.title}</h3>
        <p class="text-sm text-ink-muted">{service.description}</p>
      </li>
    ))}
  </ul>

  <div class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-end">
    <figure class="m-0 w-full max-w-xs sm:w-48 sm:max-w-none sm:shrink-0">
      <Image
        class="rounded-md"
        alt="Large dog sitting in a forest, looking at the camera. This is Shadow, our resident dog and a very very good boy."
        src={HeroImage}
      />
      <figcaption class="mt-2 text-sm text-ink-subtle">Shadow, our resident dog and a very good boy.</figcaption>
    </figure>

    <a
      href="/contact"
      class="inline-flex min-h-11 items-center rounded-sm bg-accent px-5 py-2 font-semibold text-on-accent hover:underline"
    >
      Contact me
    </a>
  </div>
</section>
