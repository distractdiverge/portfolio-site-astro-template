---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, thumbnail, headerImage } = project.data;
// Prefer the thumbnail; fall back to the header image; otherwise the solid fallback block shows.
const image = thumbnail ?? headerImage;
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col overflow-hidden rounded-lg bg-card shadow-paper ring-1 ring-line transition-shadow hover:shadow-paper-md"
>
  <div class="aspect-[4/3] overflow-hidden bg-fallback">
    {
      image && (
        <Image
          src={image}
          alt=""
          class="h-full w-full object-cover"
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
        />
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h2 class="line-clamp-2 text-lg font-semibold text-heading group-hover:underline">
      {title}
    </h2>
    <p class="line-clamp-3 flex-1 text-sm text-ink-muted">{description}</p>
  </div>
</a>
