---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetaSEO from "../components/MetaSEO.astro";
import type { MetaSEOProperties } from "../components/MetaSEO.astro";

interface LayoutProps extends MetaSEOProperties {
  wide?: boolean;
}

const { title, description, image, article, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <MetaSEO
        title={title}
        description={description}
        image={image}
        article={article}
    />

    <!-- Runs before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return sessionStorage.getItem('theme-override');
          } catch (e) {
            return null;
          }
        })();
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark' ? stored : system;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-page text-ink antialiased">
    <Header />
    <main class={`mx-auto w-full flex-1 px-6 py-10 ${wide ? 'max-w-7xl' : 'max-w-3xl'}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
