---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../lib/projects';

const featured = await getFeaturedProjects(2);
---

<Layout title="About">
  <h1 class="text-3xl font-bold text-emerald-900">About</h1>
  <p class="mt-4 text-stone-700">Placeholder content for the About page.</p>

  <section class="mt-12">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold text-emerald-900">Featured projects</h2>
      <a href="/projects" class="text-emerald-700 hover:underline">View all projects →</a>
    </div>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        featured.map((project) => (
          <li class="flex">
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
