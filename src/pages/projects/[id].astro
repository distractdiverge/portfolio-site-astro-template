---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { formatMonthYear, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, codeUrl, assets, headerImage, startedDate, lastUpdated } =
  project.data;
const { Content } = await render(project);
---

<Layout title={title}>
  <article class="relative">
    <!-- Desktop only: sits in the empty gutter to the left of the content column. -->
    <a
      href="/projects"
      class="hidden whitespace-nowrap text-sm font-semibold text-emerald-700 hover:underline lg:absolute lg:top-1 lg:right-full lg:mr-6 lg:block"
    >← All projects</a>

    <header
      class="relative isolate flex aspect-[16/6] min-h-48 items-end overflow-hidden rounded-xl bg-gradient-to-br from-emerald-700 to-emerald-900"
    >
      {
        headerImage && (
          <Image src={headerImage} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" />
        )
      }
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 to-transparent" />
      <h1 class="p-6 text-3xl font-bold text-white sm:text-4xl">{title}</h1>
    </header>

    <p class="mt-4 text-sm text-stone-500">
      Started <time datetime={startedDate.toISOString()}>{formatMonthYear(startedDate)}</time>
      {
        lastUpdated && (
          <>
            {' · '}Updated <time datetime={lastUpdated.toISOString()}>{formatMonthYear(lastUpdated)}</time>
          </>
        )
      }
    </p>

    <p class="mt-6 text-lg text-stone-700">{description}</p>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      <a
        href={codeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-emerald-700 hover:underline">Code →</a
      >
    </div>

    {
      assets.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-emerald-900">Assets</h2>
          <ul class="mt-2 list-inside list-disc space-y-1 text-stone-700">
            {assets.map((asset) => (
              <li>
                <a
                  href={asset.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-emerald-700 hover:underline">{asset.label}</a
                >
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose prose-stone mt-10 max-w-none">
      <Content />
    </div>

    <p class="mt-16 border-t border-stone-200 pt-6">
      <a href="/projects" class="font-semibold text-emerald-700 hover:underline">← All projects</a>
    </p>
  </article>
</Layout>
